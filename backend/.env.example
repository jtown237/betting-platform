DATABASE_URL=postgresql://user:password@localhost:5432/betting_db
JWT_SECRET=your-secret-key-change-this
ODDSAPI_KEY=your-oddsapi-key
ESPN_API_BASE=https://site.api.espn.com/apis/site/v2
ENVIRONMENT=development

# OddsAPI request tuning. Credit cost per request is markets x regions, and
# requests per day is 1440 / ODDSAPI_POLL_MINUTES per sport, so these three
# together determine spend. Exchanges such as Kalshi are not in the "us"
# region -- add "us_ex" to include them, at double the credit cost.
ODDSAPI_REGIONS=us
ODDSAPI_MARKETS=h2h,spreads,totals
ODDSAPI_POLL_MINUTES=10
